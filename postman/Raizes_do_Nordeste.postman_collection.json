          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/pagamentos/{{pedidoId2}}/processar",
            "body": { "mode": "raw", "raw": "{\n  \"simularFalha\": true\n}" }
          }
        }
