      "item": [
        {
          "name": "S01 - Criar usuário ADMIN",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.collectionVariables.set('tokenAdmin', pm.response.json().accessToken);",
                "pm.collectionVariables.set('token', pm.response.json().accessToken);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Admin Sistema\",\n  \"email\": \"admin@raizes.com\",\n  \"senha\": \"Senha@123\",\n  \"perfil\": \"ADMIN\",\n  \"consentimentoLgpd\": false\n}"
            }
          }
        },
        {
          "name": "S02 - Criar unidade",
