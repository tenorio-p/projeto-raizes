                "pm.test('Status AGUARDANDO_PAGAMENTO', () => pm.expect(pm.response.json().status).to.eql('AGUARDANDO_PAGAMENTO'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"APP\",\n  \"unidadeId\": {{unidadeId}},\n  \"itens\": [\n    { \"produtoId\": {{produtoId}}, \"quantidade\": 2 },\n    { \"produtoId\": {{produtoId2}}, \"quantidade\": 1 }\n  ],\n  \"formaPagamento\": \"PIX\"\n}"
            }
          }
        },
