            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": {{unidadeId}},\n  \"itens\": [{ \"produtoId\": {{produtoId}}, \"quantidade\": 1 }],\n  \"formaPagamento\": \"PIX\"\n}"
            }
