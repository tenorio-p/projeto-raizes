          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Chef Cozinha\",\n  \"email\": \"cozinha@raizes.com\",\n  \"senha\": \"Senha@123\",\n  \"perfil\": \"COZINHA\",\n  \"consentimentoLgpd\": false\n}"
            }
          }
        }
      ]
    },
    {
      "name": "1 - Auth",
      "item": [
        {
          "name": "T01 - Login válido (CLIENTE)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Tem accessToken', () => {",
                "  const json = pm.response.json();",
                "  pm.expect(json.accessToken).to.be.a('string');",
                "  pm.collectionVariables.set('token', json.accessToken);",
                "});"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@email.com\",\n  \"senha\": \"Senha@123\"\n}"
            }
          }
        },
        {
          "name": "T02 - Acesso sem token (403)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));"]
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/pedidos"
          }
        },
