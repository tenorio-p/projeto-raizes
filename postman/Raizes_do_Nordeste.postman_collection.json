          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"WEB\",\n  \"unidadeId\": {{unidadeId}},\n  \"itens\": [{ \"produtoId\": 9999, \"quantidade\": 1 }],\n  \"formaPagamento\": \"PIX\"\n}"
            }
          }
        },
        {
          "name": "T10 - Filtrar pedidos por canal (APP)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('É paginado', () => pm.expect(pm.response.json()).to.have.property('content'));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/pedidos?canalPedido=APP&page=0&size=10",
              "query": [
                { "key": "canalPedido", "value": "APP" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
