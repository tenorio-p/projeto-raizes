              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"WEB\",\n  \"unidadeId\": {{unidadeId}},\n  \"itens\": [\n    { \"produtoId\": {{produtoId}}, \"quantidade\": 1 }\n  ],\n  \"formaPagamento\": \"PIX\"\n}"
            }
          }
        },
