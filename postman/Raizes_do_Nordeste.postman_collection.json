          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/unidades"
          }
        },
        {
          "name": "T06 - Cardápio da unidade",
          "event": [{
            "listen": "test",
            "script": {
