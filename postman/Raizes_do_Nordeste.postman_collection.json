                "pm.test('Tem produtos', () => pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty);"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/unidades/{{unidadeId}}/cardapio"
          }
